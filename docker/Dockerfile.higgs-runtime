# syntax=docker/dockerfile:1

FROM frankleeeee/sglang-omni:dev

ENV PIP_ROOT_USER_ACTION=ignore \
    UV_LINK_MODE=copy

WORKDIR /workspace/sglang-omni

COPY . /workspace/sglang-omni

# Use uv instead of pip so pyproject.toml [tool.uv] overrides are honored.
# Keep the CUDA/SGLang/FlashInfer stack from the base image. Installing the
# project dependency set verbatim can replace the tuned base-image SGLang build
# with the PyPI pin, which is not representative for performance testing.
RUN python -m pip install --break-system-packages -U uv && \
    printf '%s\n' \
        sglang \
        torch \
        torchvision \
        flashinfer \
        flashinfer-python \
        flashinfer-jit-cache \
        > /tmp/sglomni-uv-excludes.txt && \
    uv pip install -v -e . --system --break-system-packages \
        --excludes /tmp/sglomni-uv-excludes.txt

ENTRYPOINT ["sgl-omni"]
